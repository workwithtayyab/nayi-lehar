---
import StaticPage from '../components/StaticPage.astro';
import { AUTHORS } from '../data/authors';
import { url } from '../lib/utils';
---
<StaticPage title="हमारे बारे में" description="नई लहर एक हिंदी डिजिटल पब्लिकेशन है — Gen-Z भारत के लिए, Gen-Z भारत की भाषा में।">
  <h2>हमारा मकसद</h2>
  <p>हम मानते हैं कि खबरें बोरिंग नहीं होनी चाहिए, और ज़रूरी जानकारी सिर्फ़ अंग्रेज़ी में नहीं होनी चाहिए। नई लहर पर हम बड़ी खबरों को आसान हिंदी में समझाते हैं — बिना शोर, बिना क्लिकबेट।</p>
  <h2>हमारे उसूल</h2>
  <ul>
    <li><strong>तथ्य पहले:</strong> हर दावे की पुष्टि, हर आंकड़े का स्रोत।</li>
    <li><strong>आसान भाषा:</strong> जटिल मुद्दे, सरल शब्द।</li>
    <li><strong>पारदर्शिता:</strong> गलती होने पर साफ़ सुधार और अपडेट नोट।</li>
    <li><strong>सबके लिए:</strong> तेज़, हल्की और एक्सेसिबल वेबसाइट — कमज़ोर नेटवर्क पर भी।</li>
  </ul>
  <h2>हमारी टीम</h2>
  <ul>{AUTHORS.map((a) => <li><a href={url(`/author/${a.slug}`)}>{a.name}</a> — {a.role}</li>)}</ul>
  <blockquote><p>यह एक डेमो वेबसाइट है। सभी लेख, लेखक और तस्वीरें प्रदर्शन के उद्देश्य से हैं।</p></blockquote>
</StaticPage>
