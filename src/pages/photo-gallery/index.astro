---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { Image } from 'astro:assets';
import { GALLERIES } from '../../data/media';
import { img } from '../../lib/images';
import { formatShortDate, url } from '../../lib/utils';
---
<Base title="फोटो गैलरी" description="तस्वीरों में कहानियां — ट्रैवल, फ़ूड, फेस्टिवल और भी बहुत कुछ।">
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'फोटो गैलरी' }]} />
    <header class="page-head"><h1>फोटो गैलरी</h1><p>तस्वीरों में कहानियां — ट्रैवल, फ़ूड, फेस्टिवल और भी बहुत कुछ।</p></header>
    <div class="grid grid-3">
      {GALLERIES.map((g, i) => (
        <article class="g">
          <a href={url(`/photo-gallery/${g.slug}`)}>
            <span class="th"><Image src={img(g.photos[0].image)} alt="" widths={[360, 540, 720]} sizes="(max-width: 600px) 100vw, 400px" loading={i < 2 ? 'eager' : 'lazy'} /><span class="cnt">{g.photos.length} फ़ोटो</span></span>
            <h2 class="clamp-2">{g.title}</h2>
          </a>
          <p class="ex clamp-2">{g.excerpt}</p>
          <p class="meta"><time datetime={g.date}>{formatShortDate(g.date)}</time></p>
        </article>
      ))}
    </div>
  </div>
</Base>
<style>
  .g a { display: grid; gap: 10px; } .g h2 { font-size: 1.15rem; margin: 0; } .g a:hover h2 { color: var(--brand-2); }
  .th { position: relative; display: block; aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden; }
  .th :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .cnt { position: absolute; right: 10px; bottom: 10px; background: rgb(0 0 0 / .7); color: #fff; padding: 2px 10px; border-radius: 999px; font-size: .8rem; }
  .ex { color: var(--text-2); margin: 8px 0 4px; }
</style>
