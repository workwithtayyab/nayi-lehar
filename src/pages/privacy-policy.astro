import StaticPage from '../components/StaticPage.astro';
---
<StaticPage title="प्राइवेसी पॉलिसी" description="हम आपका डेटा कैसे संभालते हैं — सीधे और साफ़ शब्दों में।">
  <h2>हम क्या स्टोर करते हैं</h2>
  <p>यह वेबसाइट कोई अकाउंट, ट्रैकिंग कुकी या थर्ड-पार्टी एनालिटिक्स इस्तेमाल नहीं करती। आपकी थीम (लाइट/डार्क) और सेव किए गए लेख सिर्फ़ आपके ब्राउज़र के <strong>localStorage</strong> में रहते हैं और हमारे सर्वर पर नहीं भेजे जाते।</p>
  <h2>वीडियो</h2>
  <p>वीडियो YouTube के privacy-enhanced मोड (youtube-nocookie.com) से तभी लोड होते हैं जब आप प्ले बटन दबाते हैं।</p>
  <h2>फ़ॉर्म</h2>
  <p>न्यूज़लेटर और संपर्क फ़ॉर्म इस डेमो में कोई डेटा कहीं नहीं भेजते।</p>
  <h2>आपके अधिकार</h2>
  <p>ब्राउज़र का साइट डेटा क्लियर करके आप सारा स्टोर किया गया डेटा कभी भी हटा सकते हैं।</p>
</StaticPage>
