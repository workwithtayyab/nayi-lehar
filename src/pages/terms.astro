import StaticPage from '../components/StaticPage.astro';
---
<StaticPage title="नियम और शर्तें" description="इस वेबसाइट के इस्तेमाल की शर्तें।">
  <h2>कंटेंट</h2>
  <p>नई लहर एक डेमो प्रोजेक्ट है। यहां के लेख उदाहरण के तौर पर लिखे गए हैं और इन्हें पेशेवर, मेडिकल, कानूनी या वित्तीय सलाह न मानें।</p>
  <h2>तस्वीरें और वीडियो</h2>
  <p>तस्वीरें Unsplash (Lorem Picsum के ज़रिए) से हैं और वीडियो Blender Foundation की ओपन-लाइसेंस फ़िल्में हैं।</p>
  <h2>बाहरी लिंक</h2>
  <p>बाहरी वेबसाइटों के कंटेंट के लिए हम ज़िम्मेदार नहीं हैं।</p>
</StaticPage>
