---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { AUTHORS, type Author } from '../../data/authors';
import { byAuthor } from '../../data/articles';
import { initials, absoluteUrl } from '../../lib/utils';
export function getStaticPaths() { return AUTHORS.map((a) => ({ params: { slug: a.slug }, props: { author: a } })); }
const { author } = Astro.props as { author: Author };
const items = byAuthor(author.slug);
const ld = { '@context': 'https://schema.org', '@type': 'Person', name: author.nameEn, alternateName: author.name, jobTitle: author.role, url: absoluteUrl(`/author/${author.slug}`, Astro.site) };
---
<Base title={author.name} description={author.bio} jsonLd={ld}>
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'लेखक' }, { name: author.name }]} />
    <header class="ah">
      <span class="av" style={`background:${author.color}`} aria-hidden="true">{initials(author.nameEn)}</span>
      <div><h1>{author.name}</h1><p class="role">{author.role}</p><p>{author.bio}</p><p class="meta">{items.length} लेख</p></div>
    </header>
    <div class="grid grid-4">{items.map((a) => <ArticleCard article={a} headingLevel="h2" />)}</div>
  </div>
</Base>
<style>
  .ah { display: flex; gap: 24px; align-items: center; padding: 28px 0 36px; flex-wrap: wrap; }
  .av { width: 96px; height: 96px; border-radius: 50%; color: #fff; display: grid; place-items: center; font-size: 2rem; font-weight: 700; flex-shrink: 0; }
  h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0; }
  .role { color: var(--brand-2); font-weight: 600; margin: 0 0 8px; }
  .ah p { max-width: 65ch; }
</style>
