---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
import { absoluteUrl, url } from '../lib/utils';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { img } from '../lib/images';
import poppins400 from '@fontsource/poppins/files/poppins-devanagari-400-normal.woff2?url';
import poppins700 from '@fontsource/poppins/files/poppins-devanagari-700-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  bare?: boolean;
  publishedTime?: string;
}
const { title, description = SITE.description, image, type = 'website', jsonLd, noindex = false, bare = false, publishedTime } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} (${SITE.nameHi}) — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const og = await getImage({ src: image ?? img('img-26'), width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const ogUrl = new URL(og.src, Astro.site).toString();
const ld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: absoluteUrl('/', Astro.site), inLanguage: 'hi-IN',
    potentialAction: { '@type': 'SearchAction', target: `${absoluteUrl('/search', Astro.site)}?q={search_term_string}`, 'query-input': 'required name=search_term_string' } },
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---
<!doctype html>
<html lang="hi" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#1b0f5c" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('/rss.xml')} />
    <link rel="preload" href={poppins400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins700} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <script is:inline>
      (() => { try { const t = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); document.documentElement.dataset.theme = t; } catch (e) {} })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">मुख्य सामग्री पर जाएं</a>
    {!bare && <Header />}
    <main id="main" tabindex="-1"><slot /></main>
    {!bare && <Footer />}
    <div class="toast" role="status" aria-live="polite" data-toast hidden></div>
    <script>
      import '../scripts/site';
    </script>
    <style is:global>
      .toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); background: var(--text); color: var(--bg); padding: 10px 18px; border-radius: 999px; z-index: 90; font-size: .92rem; box-shadow: var(--shadow); }
    </style>
  </body>
</html>
