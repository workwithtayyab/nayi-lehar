---
import { url } from '../lib/utils';
interface Props { current: number; last: number; base: string }
const { current, last, base } = Astro.props;
const href = (n: number) => url(n === 1 ? base : `${base}/page/${n}`);
const pages = Array.from({ length: last }, (_, i) => i + 1);
---
{last > 1 && (
  <nav class="pg" aria-label="पेज नेविगेशन">
    {current > 1 ? <a href={href(current - 1)} rel="prev">‹ पिछला</a> : <span aria-hidden="true" class="off">‹ पिछला</span>}
    <ul>{pages.map((n) => <li>{n === current ? <span aria-current="page">{n}</span> : <a href={href(n)} aria-label={`पेज ${n}`}>{n}</a>}</li>)}</ul>
    {current < last ? <a href={href(current + 1)} rel="next">अगला ›</a> : <span aria-hidden="true" class="off">अगला ›</span>}
  </nav>
)}
<style>
  .pg { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 40px; flex-wrap: wrap; }
  ul { display: flex; gap: 6px; list-style: none; padding: 0; margin: 0; }
  a, span { display: inline-grid; place-items: center; min-width: 44px; min-height: 44px; padding: 0 12px; border-radius: var(--radius-sm); border: 1px solid var(--border); font-weight: 600; }
  a:hover { background: var(--bg-soft); }
  [aria-current] { background: var(--brand); color: #fff; border-color: var(--brand); }
  :global([data-theme='dark']) [aria-current] { color: #120a3d; }
  .off { opacity: .4; }
</style>
