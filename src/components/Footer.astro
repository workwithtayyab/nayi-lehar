---
import Logo from './Logo.astro';
import { CATEGORIES, SITE, SECTION_LINKS } from '../config/site';
import { url } from '../lib/utils';
const year = new Date().getFullYear();
const socials = [
  { name: 'Instagram', href: SITE.social.instagram, d: 'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm6-1.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z' },
  { name: 'X', href: SITE.social.x, d: 'M4 3h4.5l4 5.6L17.5 3H20l-6.3 7.4L21 21h-4.5l-4.4-6.1L6.6 21H4l7-8.1z' },
  { name: 'YouTube', href: SITE.social.youtube, d: 'M22 8.2a3 3 0 0 0-2.1-2.1C18 5.6 12 5.6 12 5.6s-6 0-7.9.5A3 3 0 0 0 2 8.2 31 31 0 0 0 1.6 12 31 31 0 0 0 2 15.8a3 3 0 0 0 2.1 2.1c1.9.5 7.9.5 7.9.5s6 0 7.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .4-3.8 31 31 0 0 0-.4-3.8zM10 15V9l5.2 3z' },
  { name: 'LinkedIn', href: SITE.social.linkedin, d: 'M4.5 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM3 8.5h3V21H3zm6 0h2.9v1.7h.1c.4-.8 1.4-1.9 3.1-1.9 3.3 0 3.9 2.2 3.9 5V21h-3v-6.8c0-1.6 0-3.7-2.3-3.7S12 12.3 12 14v7H9z' },
  { name: 'Facebook', href: SITE.social.facebook, d: 'M14 8h3V4h-3a4 4 0 0 0-4 4v2H8v4h2v8h4v-8h3l1-4h-4V8z' },
];
---
<section class="newsletter" id="newsletter" aria-labelledby="nl-title">
  <div class="wrap nl-inner">
    <div>
      <h2 id="nl-title">हर सुबह की सबसे ज़रूरी खबरें, सीधे आपके इनबॉक्स में</h2>
      <p>5 मिनट में पढ़ें, दिन भर अपडेट रहें। कोई स्पैम नहीं — कभी भी अनसब्सक्राइब करें।</p>
    </div>
    <form class="nl-form" data-newsletter novalidate>
      <label class="sr-only" for="nl-email">ईमेल पता</label>
      <input id="nl-email" class="input" type="email" name="email" placeholder="आपका ईमेल" autocomplete="email" required />
      <button class="btn btn-primary" type="submit">सब्सक्राइब करें</button>
      <p class="nl-msg" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
<footer class="site-footer">
  <div class="wrap cols">
    <div class="about">
      <a href={url('/')} aria-label="होम"><Logo /></a>
      <p>{SITE.description}</p>
      <ul class="social" aria-label="सोशल मीडिया">
        {socials.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d={s.d} fill="currentColor" /></svg></a></li>
        ))}
      </ul>
    </div>
    <nav aria-label="कैटेगरी">
      <h2>कैटेगरी</h2>
      <ul class="two">{CATEGORIES.map((c) => <li><a href={url(`/${c.slug}`)}>{c.name}</a></li>)}</ul>
    </nav>
    <nav aria-label="और देखें">
      <h2>और देखें</h2>
      <ul>
        {SECTION_LINKS.map((s) => <li><a href={url(`/${s.href}`)}>{s.name}</a></li>)}
        <li><a href={url('/latest')}>ताज़ा खबरें</a></li>
        <li><a href={url('/rss.xml')}>RSS फ़ीड</a></li>
      </ul>
    </nav>
    <nav aria-label="क्विक लिंक्स">
      <h2>क्विक लिंक्स</h2>
      <ul>
        <li><a href={url('/about')}>हमारे बारे में</a></li>
        <li><a href={url('/advertise')}>विज्ञापन दें</a></li>
        <li><a href={url('/contact')}>संपर्क करें</a></li>
        <li><a href={url('/privacy-policy')}>प्राइवेसी पॉलिसी</a></li>
        <li><a href={url('/terms')}>नियम और शर्तें</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap bottom">
    <p>© {year} {SITE.name}. सर्वाधिकार सुरक्षित।</p>
    <p class="demo">डेमो वेबसाइट: सभी लेख और तस्वीरें प्रदर्शन के लिए हैं।</p>
  </div>
</footer>
<style>
  .newsletter { background: linear-gradient(120deg, #1b0f5c, #5b1a7a 55%, #b0124a); color: #fff; padding: 40px 0; margin-top: 48px; }
  .nl-inner { display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px; align-items: center; }
  .newsletter h2 { font-size: clamp(1.25rem, 2.6vw, 1.7rem); }
  .newsletter p { opacity: .9; margin: 0; }
  .nl-form { display: flex; flex-wrap: wrap; gap: 10px; }
  .nl-form .input { flex: 1 1 220px; background: #fff; color: #111; border: 0; }
  .nl-form .btn { background: #fff; color: #1b0f5c; }
  .nl-msg { flex-basis: 100%; min-height: 1.4em; font-size: .9rem; }
  .site-footer { background: var(--bg-soft); border-top: 1px solid var(--border); padding: 48px 0 16px; font-size: .95rem; }
  .cols { display: grid; grid-template-columns: 1.5fr 1.2fr 1fr 1fr; gap: 32px; }
  .about p { color: var(--text-2); margin-top: 14px; }
  .site-footer h2 { font-size: 1rem; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 12px; }
  .site-footer ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .site-footer ul.two { grid-template-columns: 1fr 1fr; }
  .site-footer nav a { color: var(--text-2); }
  .site-footer nav a:hover { color: var(--brand-2); text-decoration: underline; }
  .social { display: flex !important; gap: 8px !important; }
  .social a { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--bg-elev); border: 1px solid var(--border); }
  .social a:hover { background: var(--brand); color: #fff; }
  .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; border-top: 1px solid var(--border); margin-top: 32px; padding-top: 16px; color: var(--muted); font-size: .85rem; }
  .bottom p { margin: 0; }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr 1fr; } .nl-inner { grid-template-columns: 1fr; } }
  @media (max-width: 540px) { .cols { grid-template-columns: 1fr; } }
</style>
