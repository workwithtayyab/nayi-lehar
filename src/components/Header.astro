---
import Logo from './Logo.astro';
import { CATEGORIES, SECTION_LINKS } from '../config/site';
import { url } from '../lib/utils';
const path = Astro.url.pathname;
const isActive = (slug: string) => path.startsWith(url(`/${slug}`));
---
<header class="site-header">
  <div class="wrap bar">
    <button class="icon-btn menu-btn" type="button" aria-label="मेन्यू खोलें" aria-controls="drawer" aria-expanded="false" data-menu-open>
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h12M3 17h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <a href={url('/')} class="brand"><Logo /></a>
    <nav class="main-nav" aria-label="मुख्य">
      <ul>
        <li><a href={url('/news')} aria-current={isActive('news') ? 'page' : undefined}>खबरें</a></li>
        <li><a href={url('/videos')} aria-current={isActive('videos') ? 'page' : undefined}>वीडियो</a></li>
        <li><a href={url('/web-story')} aria-current={isActive('web-story') ? 'page' : undefined}>वेब स्टोरी</a></li>
        <li class="dd">
          <button type="button" class="dd-btn" aria-expanded="false" aria-controls="cat-menu" data-dd>
            कैटेगरी <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2"/></svg>
          </button>
          <div class="dd-menu" id="cat-menu" hidden>
            <ul>
              {CATEGORIES.map((c) => <li><a href={url(`/${c.slug}`)}><span class="dot" style={`background:${c.color}`}></span>{c.name}</a></li>)}
              {SECTION_LINKS.map((s) => <li><a href={url(`/${s.href}`)}><span class="dot"></span>{s.name}</a></li>)}
            </ul>
          </div>
        </li>
      </ul>
    </nav>
    <div class="actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="डार्क मोड चालू करें" title="थीम बदलें">
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
      </button>
      <a class="icon-btn" href={url('/bookmarks')} aria-label="सेव किए गए लेख">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
      </a>
      <a class="search-link" href={url('/search')}>
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="label">सर्च</span>
      </a>
      <a class="btn btn-primary subscribe" href="#newsletter">सब्सक्राइब</a>
    </div>
  </div>
</header>

<div class="drawer-backdrop" data-menu-close hidden></div>
<aside id="drawer" class="drawer" aria-label="मोबाइल मेन्यू" hidden>
  <div class="drawer-head">
    <Logo size={30} />
    <button class="icon-btn" type="button" aria-label="मेन्यू बंद करें" data-menu-close>
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
  <form class="drawer-search" action={url('/search')} role="search">
    <label class="sr-only" for="drawer-q">सर्च करें</label>
    <input id="drawer-q" class="input" type="search" name="q" placeholder="खबरें सर्च करें…" />
  </form>
  <nav aria-label="मोबाइल">
    <ul>
      <li><a href={url('/')}>होम</a></li>
      {CATEGORIES.map((c) => <li><a href={url(`/${c.slug}`)}><span class="dot" style={`background:${c.color}`}></span>{c.name}</a></li>)}
      {SECTION_LINKS.map((s) => <li><a href={url(`/${s.href}`)}><span class="dot"></span>{s.name}</a></li>)}
      <li><a href={url('/bookmarks')}>सेव किए गए लेख</a></li>
      <li><a href={url('/about')}>हमारे बारे में</a></li>
    </ul>
  </nav>
</aside>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: saturate(180%) blur(10px); border-bottom: 1px solid var(--border); }
  .bar { display: flex; align-items: center; gap: 16px; height: var(--header-h); }
  .brand { flex-shrink: 0; }
  .main-nav { margin-inline: auto; }
  .main-nav > ul { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .main-nav a, .dd-btn { display: inline-flex; align-items: center; gap: 4px; padding: 8px 12px; border-radius: var(--radius-sm); font-weight: 600; font-size: .95rem; background: none; border: 0; }
  .main-nav a:hover, .dd-btn:hover, .main-nav a[aria-current] { background: var(--bg-soft); }
  .main-nav a[aria-current] { color: var(--brand-2); }
  .dd { position: relative; }
  .dd-btn[aria-expanded='true'] svg { transform: rotate(180deg); }
  .dd-menu { position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%); background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 10px; min-width: 420px; }
  .dd-menu ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
  .dd-menu a { width: 100%; font-weight: 500; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); display: inline-block; margin-right: 6px; flex-shrink: 0; }
  .actions { display: flex; align-items: center; gap: 8px; }
  .icon-btn { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: none; border: 0; }
  .icon-btn:hover { background: var(--bg-soft); }
  .theme-toggle { display: inline-flex; gap: 2px; padding: 4px; border-radius: 999px; background: var(--bg-soft); border: 1px solid var(--border); }
  .theme-toggle svg { width: 30px; height: 30px; padding: 6px; border-radius: 50%; }
  :global([data-theme='light']) .theme-toggle .sun, :global([data-theme='dark']) .theme-toggle .moon { background: var(--bg-elev); box-shadow: 0 1px 3px rgb(0 0 0 / .15); }
  .search-link { display: inline-flex; align-items: center; gap: 6px; padding: 8px 10px; border-radius: var(--radius-sm); font-weight: 600; }
  .search-link:hover { background: var(--bg-soft); }
  .menu-btn { display: none; }
  .drawer { position: fixed; inset: 0 auto 0 0; width: min(86vw, 340px); background: var(--bg-elev); z-index: 70; padding: 16px; overflow-y: auto; box-shadow: var(--shadow); }
  .drawer-backdrop { position: fixed; inset: 0; background: rgb(0 0 0 / .5); z-index: 60; }
  .drawer-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  .drawer-search { margin-bottom: 8px; }
  .drawer ul { list-style: none; padding: 0; margin: 0; }
  .drawer nav a { display: flex; align-items: center; padding: 12px 8px; border-bottom: 1px solid var(--border); font-weight: 500; }
  @media (max-width: 1020px) { .main-nav, .subscribe { display: none; } .menu-btn { display: inline-grid; } .brand { margin-right: auto; } }
  @media (max-width: 560px) { .search-link .label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; } .theme-toggle { display: none; } .bar { gap: 4px; } }
</style>
