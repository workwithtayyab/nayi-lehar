---
import { Image } from 'astro:assets';
import type { Article } from '../data/types';
import { getCategory } from '../config/site';
import { getAuthor } from '../data/authors';
import { formatShortDate, url } from '../lib/utils';
import { img } from '../lib/images';
interface Props { items: Article[] }
const { items } = Astro.props;
---
<section class="hero" aria-roledescription="carousel" aria-label="टॉप स्टोरीज़" data-carousel>
  <div class="track" data-track tabindex="0" aria-label="टॉप स्टोरीज़ स्लाइड्स">
    {items.map((a, i) => {
      const cat = getCategory(a.category)!;
      return (
        <article class="slide" aria-roledescription="slide" aria-label={`${i + 1} / ${items.length}`}>
          <Image src={img(a.image)} alt="" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, 1240px" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
          <div class="cap">
            <a class="chip" href={url(`/${cat.slug}`)}>{cat.name}</a>
            <h2 class="clamp-3"><a href={url(a.href)}>{a.title}</a></h2>
            <p class="meta"><span>By <strong>{getAuthor(a.author).name}</strong></span><time datetime={a.date}>{formatShortDate(a.date)}</time></p>
          </div>
        </article>
      );
    })}
  </div>
  <button class="nav prev" type="button" data-prev aria-label="पिछली स्टोरी"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.5"/></svg></button>
  <button class="nav next" type="button" data-next aria-label="अगली स्टोरी"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5"/></svg></button>
  <div class="dots" role="group" aria-label="स्लाइड चुनें">
    {items.map((_, i) => <button type="button" data-dot={i} aria-label={`स्लाइड ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}></button>)}
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    let idx = 0;
    const go = (i: number) => { idx = (i + slides.length) % slides.length; track.scrollTo({ left: slides[idx].offsetLeft - track.offsetLeft, behavior: 'smooth' }); };
    root.querySelector('[data-prev]')!.addEventListener('click', () => go(idx - 1));
    root.querySelector('[data-next]')!.addEventListener('click', () => go(idx + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    track.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') { e.preventDefault(); go(idx + 1); } if (e.key === 'ArrowLeft') { e.preventDefault(); go(idx - 1); } });
    const io = new IntersectionObserver((es) => es.forEach((en) => { if (en.isIntersecting) { idx = slides.indexOf(en.target as HTMLElement); dots.forEach((d, i) => d.toggleAttribute('aria-current', i === idx)); } }), { root: track, threshold: 0.6 });
    slides.forEach((s) => io.observe(s));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: number | undefined;
    const start = () => { if (!reduce) timer = window.setInterval(() => go(idx + 1), 6000); };
    const stop = () => clearInterval(timer);
    root.addEventListener('mouseenter', stop); root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop); root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  });
</script>
<style>
  .hero { position: relative; margin-top: 20px; border-radius: var(--radius); overflow: hidden; background: #111; }
  .track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .track::-webkit-scrollbar { display: none; }
  .slide { position: relative; flex: 0 0 100%; scroll-snap-align: start; aspect-ratio: 16 / 7; min-height: 340px; max-height: 560px; width: 100%; }
  .slide :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .cap { position: absolute; inset: auto 0 0 0; padding: clamp(18px, 4vw, 44px); padding-bottom: 52px; background: linear-gradient(transparent, rgb(0 0 0 / .88) 60%); color: #fff; display: grid; gap: 10px; justify-items: start; }
  .cap h2 { font-size: clamp(1.25rem, 3.2vw, 2.3rem); margin: 0; max-width: 30ch; }
  .cap h2 a:hover { text-decoration: underline; }
  .cap .chip { background: var(--brand-2); color: #fff; }
  .cap .meta, .cap .meta strong { color: rgb(255 255 255 / .85); }
  .nav { position: absolute; top: 50%; transform: translateY(-50%); width: 48px; height: 48px; border-radius: 50%; border: 0; background: rgb(255 255 255 / .9); color: #111; display: grid; place-items: center; box-shadow: var(--shadow); }
  .nav:hover { background: #fff; }
  .prev { left: 16px; } .next { right: 16px; }
  .dots { position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%); display: flex; gap: 4px; }
  .dots button { width: 24px; height: 24px; border: 0; background: none; padding: 0; display: grid; place-items: center; }
  .dots button::before { content: ''; width: 8px; height: 8px; border-radius: 999px; background: rgb(255 255 255 / .5); transition: width .2s; }
  .dots button[aria-current]::before { width: 22px; background: #fff; }
  @media (max-width: 640px) { .slide { aspect-ratio: 4 / 5; max-height: 520px; } .nav { display: none; } .hero { border-radius: 0; margin-inline: calc(-1 * var(--gap)); } }
</style>
