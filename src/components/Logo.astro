---
import { SITE } from '../config/site';
interface Props { size?: number }
const { size = 34 } = Astro.props;
---
<span class="logo" style={`--s:${size}px`}>
  <svg viewBox="0 0 48 48" width={size} height={size} aria-hidden="true" focusable="false">
    <defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff3d6e"/><stop offset=".5" stop-color="#ff9f1c"/><stop offset="1" stop-color="#5b3bff"/></linearGradient></defs>
    <rect width="48" height="48" rx="12" fill="url(#lg)"/>
    <path d="M6 30c5-6 9-6 13 0s8 6 12 0 8-6 11-1" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round"/>
    <path d="M6 20c5-6 9-6 13 0s8 6 12 0 8-6 11-1" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width="3" stroke-linecap="round"/>
  </svg>
  <span class="logo-text"><span class="hi">{SITE.nameHi}</span><span class="en">{SITE.name}</span></span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .logo-text { display: grid; line-height: 1.05; }
  .hi { font-weight: 700; font-size: calc(var(--s) * .62); background: linear-gradient(90deg, #e8335a, #ff9f1c 55%, #5b3bff); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .en { font-size: calc(var(--s) * .3); letter-spacing: .18em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
</style>
